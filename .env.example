# Required in production (NODE_ENV=production fails closed if empty unless ALLOW_UNAUTHENTICATED_ADMIN=true)
ADMIN_PASSWORD=change-me-to-a-strong-password
# ALLOW_UNAUTHENTICATED_ADMIN=false

# Optional overrides (auto-generated and persisted in PGlite if omitted)
# SESSION_SECRET=

# Server & storage (Docker manifests override DATA_DIR to /data/pgdata)
PORT=3000
DATA_DIR=./data/pgdata
SEED_SAMPLE_PROJECT=true
# Set to true when running behind Railway, Render, Fly.io, Caddy, or Nginx TLS proxy
TRUST_PROXY=false

# Optional default LLM provider (can also be configured in the /settings UI)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini